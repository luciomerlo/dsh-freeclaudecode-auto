# Environment template for dsh-freeclaudecode-auto.
#
# The plugin reads provider keys from the live process environment and from
# Free Claude Code's own `~/.fcc/.env`. Copy a key here only if you launch the
# harness from a shell that loads this file; never commit a real key.
#
# Free Claude Code itself reads `~/.fcc/.env`; prefer configuring keys there
# (Admin UI or a text editor) so fcc and this plugin share one source.

# --- Preferred backend: Free Claude Code -----------------------------------
# The local proxy endpoint. Leave unset to use http://127.0.0.1:8082.
# FCC_BASE_URL=http://127.0.0.1:8082

# Proxy bearer token, only when Proxy Authentication is enabled in fcc Admin.
# ANTHROPIC_AUTH_TOKEN=

# --- Direct providers, used when the fcc proxy is not running --------------
# Set the ones you actually have. Unset providers are skipped.
# NVIDIA_NIM_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# TOGETHER_API_KEY=
# SAMBANOVA_API_KEY=
# SILICONFLOW_API_KEY=
# NEBIUS_API_KEY=
# FIREWORKS_API_KEY=
# NOVITA_API_KEY=
# ZAI_API_KEY=
# KIMI_API_KEY=
# MINIMAX_API_KEY=
# HUGGINGFACE_API_KEY=
